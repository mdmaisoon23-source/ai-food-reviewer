# Free key from https://console.groq.com  (optional: without it a built-in template script is used)
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Video size / speed (smaller = faster on free hosting)
VIDEO_WIDTH=720
VIDEO_HEIGHT=1280
VIDEO_FPS=24

# Show an "AI-GENERATED" badge on the video (recommended, keep true when posting publicly)
AI_WATERMARK=true

# Realistic talking head via a free Colab GPU worker (see colab/head_worker_colab.ipynb)
# TALKING_HEAD_URL=https://xxxx.trycloudflare.com
# TALKING_HEAD_TOKEN=
# Face photo to animate (fictional AI-generated face or your own): backend/assets/characters/portrait.png

# Optional external talking-head engine, run once per scene. Placeholders: {image} {audio} {output}
# TALKING_HEAD_CMD=python /opt/Wav2Lip/inference.py --face {image} --audio {audio} --outfile {output}
